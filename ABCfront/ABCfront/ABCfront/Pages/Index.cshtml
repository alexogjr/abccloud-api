@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<h1>@Model.ApiData.IsAdmin</h1>
<h1>@Model.ApiData.UsuarioServico</h1>
@* <h1>@Model.ApiData.UsuarioServidor[0]</h1> *@


<div class="relative pb-16">
    <div class="relative mx-auto max-w-7xl">
        <div class="mx-auto mt-12 grid max-w-lg gap-5 lg:max-w-none lg:grid-cols-3">

            @foreach (var idServidor in Model.ApiData.UsuarioServidor)
            {
                <h1 class="text-black">@idServidor</h1>

                <section class="relative flex h-fit flex-col gap-5 rounded-2xl border p-5 border-[#042740]">
                    <div class="flex flex-col gap-5">
                        <div class="flex flex-col">
                            <h3 class="flex items-center font-semibold dark:text-white text-gray-800">@Model.ApiData.UsuarioServico[0]</h3>
                            <p><span class="align-baseline text-2xl font-semibold dark:text-white text-gray-800">10 mins</span><span class="align-baseline text-sm dark:text-white dark:text-gray-800 bg-green rounded border-white"> Online</span></p>
                        </div>
                    </div>
                    <div class="grid auto-rows-fr gap-3">
                        <div class="min-h-5 hidden lg:block"></div>
                    </div><button id="plan0" class="relative min-w-fit inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus:outline-none focus:ring-offset-2 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 bg-[#002b55] text-white hover:bg-[#042740] h-10 px-8 gap-2">
                        <p class="text-white font-semibold">Adquirir</p><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="size-4">
                            <path d="M228,104a12,12,0,0,1-24,0V69l-59.51,59.51a12,12,0,0,1-17-17L187,52H152a12,12,0,0,1,0-24h64a12,12,0,0,1,12,12Zm-44,24a12,12,0,0,0-12,12v64H52V84h64a12,12,0,0,0,0-24H48A20,20,0,0,0,28,80V208a20,20,0,0,0,20,20H176a20,20,0,0,0,20-20V140A12,12,0,0,0,184,128Z">
                            </path>
                        </svg>
                    </button>
                    <hr class="w-full rounded-full border-2 border-[#042740]">
                    <div class="flex flex-col items-center gap-2">
                        <div class="flex w-full items-center gap-2">
                            <div class="group/attribute relative flex w-full flex-col items-center rounded-lg border-2 border-[#042740] px-4 py-2">
                                <span class="font-semibold dark:text-white text-gray-800">1024 MB</span><span class="text-xs font-semibold dark:text-[#D8D8D8] text-gray-800">RAM DDR5</span>
                            </div>
                            <div class="group/attribute relative flex w-full flex-col items-center rounded-lg border-2 border-[#042740] px-4 py-2">
                                <span class="font-semibold dark:text-white text-gray-800">100%</span><span class="text-xs font-semibold dark:text-[#D8D8D8] text-gray-800">vCPU</span>
                            </div>
                        </div>
                        <div class="relative -mb-2 mt-4 flex w-full items-center justify-center gap-1 text-xs">
                            <hr class="w-full rounded-full border-2 border-[#042740]">
                        </div>
                    </div>

                </section>
            }

        </div>

    </div>
</div>